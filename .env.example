# Шаблон .env для сайта на общем SEO-агенте (seo-agent-core). Скопируй в .env и заполни ПОД САЙТ.
# Секреты сюда НЕ коммитим — .env в .gitignore. Здесь только ИМЕНА переменных, значения пустые.
# Набор переменных соответствует боевому ядру seo-agent-core.

# --- Сайт ---
SITE_URL=https://example.ru
SITE_TAG=                 # метка сайта в отчётах сетевого бота (один токен на сеть); опц.
# Тип/структура сайта задаётся в site.profile.mjs, не здесь.

# --- LLM-провайдеры (генерация/бот) ---
# ОСНОВНОЙ канал — локальный llm-proxy на VPS (свой внутренний фолбэк aigate→closerouter→anymodel→wellflow
# + подмена модели, ответ с localhost без ожидания внешних 502). Если AIGATE_BASE_URL задан — он становится
# ОСНОВНЫМ провайдером; ключ прокси не требуется (при пустом AIGATE_API_KEY подставляется 'local').
# Имя AIGATE_* историческое (сам aigate.shop закрыт 26.08.2026) — оставлено ради обратной совместимости.
AIGATE_BASE_URL=http://127.0.0.1:8791/v1
AIGATE_API_KEY=
AIGATE_MODEL=anthropic/claude-sonnet-4.6
DIALOG_MODEL=google/gemini-3.7-flash
# Прямые провайдеры-резервы (перебор по кругу при сбое прокси). base/model — из дефолтов config.mjs,
# в .env обычно кладут ТОЛЬКО ключ. Провайдер без ключа автоматически пропускается.
CLOSEROUTER_API_KEY=
ANYMODEL_API_KEY=
WELLFLOW_API_KEY=
# LLM_PRIMARY=anymodel    # опц.: поднять названный провайдер в основные (напр. ключ клиента вместо пула)

# --- xmlstock (SERP/семантика) — общий ключ ---
XMLSTOCK_USER=
XMLSTOCK_KEY=
XMLSTOCK_LR=225

# --- Arsenkin (LSI/Wordstat/PAA) — общий ключ ---
ARSENKIN_API_KEY=
ARSENKIN_REGION=225

# --- keys.so (SEO/Директ-аналитика) — ОПТ-ИН: модуль lib/keysso.mjs включается при наличии токена ---
# Хост api.keys.so, заголовок X-Keyso-TOKEN. Регионов вне Москвы нет → база msk, гео-тег в запросах.
KEYSO_TOKEN=

# --- Уникальность: content-watch (основной) → text.ru (резерв) ---
CONTENTWATCH_KEY=
CONTENTWATCH_MIN=82
TEXTRU_KEY=
TEXTRU_MIN_UNIQUE=82

# --- Картинки: Pollinations (основной, бесплатно) → kie.ai Nano Banana 2 (резерв) ---
POLLINATIONS_TOKEN=          # опц.: поднимает лимиты/приоритет Pollinations; без него тоже работает
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# --- Яндекс.Вебмастер + Метрика — СВОИ у каждого сайта ---
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=            # формат https:domain.ru:443
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER=

# --- IndexNow ---
INDEXNOW_KEY=

# --- Telegram (бот заявок/отчётов) — СВОЙ у каждого сайта ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CHANNEL=          # опц.: канал для автопостинга анонсов статей
LEAD_PORT=8787
PUBLIC_LEAD_ENDPOINT=/api/lead.php   # same-origin PHP-форвардер на хостинге (приём лидов без VPS)
LEADS_KEY=                            # общий секрет форма↔форвардер для валидации заявки

# --- MAX (доп. канал заявок, botapi.max.ru) — общий бот-токен, дублирует TG-уведомления. Опц. ---
MAX_BOT_TOKEN=

# --- Деплой: FTP-хостинг (Astro dist → FTP) ---
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=              # у части сайтов переменная называется FTP_PATH — сверяйся с deploy-скриптом
# FTP_PATH=

# --- Деплой по SSH/SFTP (альтернатива FTP, напр. через свой tools/deploy_ssh.py) ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# --- Агент ---
MAX_NEW_PAGES=5
DRY_RUN=false
BATCH_COUNT=150
CONFIDENCE_MIN=0.78
# DISABLE_FACTCHECK=false          # опц.: отключить детерминированный фактчек
# AGENT_GENERATION_ENABLED=true    # опц.: рубильник генерации
# RECRAWL_PER_DAY=140              # квота переобхода Вебмастера/день (макс ~150 на хост)
# FORCE_HTTPS=true                 # опц.: форс https при сборке/деплое

# Google PageSpeed Insights (Core Web Vitals в daily-report, блок «Качество и техника»).
# Бесплатный ключ: https://developers.google.com/speed/docs/insights/v5/get-started. Без ключа работает с квотой.
PAGESPEED_KEY=
