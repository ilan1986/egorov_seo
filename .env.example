# ── Сайт ─────────────────────────────────────────────
SITE_URL=https://your-site.ru

# ── xmlstock (семантика + анализ конкурентов) ────────
XMLSTOCK_USER=            # ваш USER id на xmlstock.com
XMLSTOCK_KEY=             # ваш ключ xmlstock
XMLSTOCK_LR=213            # регион Яндекса: 213=Москва, 225=Россия

# ── AiGate (генерация контента + диалог бота) ────────
AIGATE_BASE_URL=https://api.aigate.shop/v1
AIGATE_API_KEY=
AIGATE_MODEL=anthropic/claude-sonnet-4.6

# ── text.ru (проверка уникальности) ──────────────────
TEXTRU_KEY=                # полный 32-символьный user_key
TEXTRU_MIN_UNIQUE=82       # минимальный % уникальности для публикации

# ── Яндекс.Вебмастер (позиции, запросы) ──────────────
YANDEX_WEBMASTER_TOKEN=    # OAuth-токен
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=  # напр. https:your-site.ru:443

# ── Яндекс.Метрика (трафик, поведение) ───────────────
YANDEX_METRIKA_TOKEN=      # OAuth-токен
YANDEX_METRIKA_COUNTER=    # ID счётчика

# ── IndexNow (быстрая переиндексация) ────────────────
INDEXNOW_KEY=

# ── Telegram-бот ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # куда слать заявки и отчёты

# ── SEO-агент ────────────────────────────────────────
MAX_NEW_PAGES=3           # макс. новых страниц за прогон
DRY_RUN=true              # true = не публиковать, только лог
