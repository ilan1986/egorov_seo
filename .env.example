# Шаблон .env для сайта на общем SEO-агенте. Скопируй в .env и заполни ПОД КОНКРЕТНЫЙ САЙТ.
# Секреты сюда НЕ коммитим — .env в .gitignore.

# --- Сайт ---
SITE_URL=https://example.ru
# Тип/структура сайта задаётся в site.profile.mjs, не здесь.

# --- xmlstock (SERP/семантика) — общий ключ ---
XMLSTOCK_USER=
XMLSTOCK_KEY=
XMLSTOCK_LR=225

# --- AiGate (генерация/бот) — общий ключ ---
AIGATE_BASE_URL=https://api.aigate.shop/v1
AIGATE_API_KEY=
AIGATE_MODEL=anthropic/claude-sonnet-4.6
DIALOG_MODEL=deepseek/deepseek-v4-pro

# --- Уникальность: content-watch (основной) → text.ru (резерв) ---
CONTENTWATCH_KEY=
TEXTRU_KEY=
TEXTRU_MIN_UNIQUE=82

# --- Arsenkin (LSI/Wordstat/PAA) — общий ключ ---
ARSENKIN_API_KEY=
ARSENKIN_REGION=225

# --- Яндекс.Вебмастер + Метрика — СВОИ у каждого сайта ---
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER=

# --- IndexNow ---
INDEXNOW_KEY=

# --- Telegram (бот заявок/отчётов) — СВОЙ у каждого сайта ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_PORT=8787
PUBLIC_LEAD_ENDPOINT=/api/lead.php

# --- MAX (доп. канал заявок, botapi.max.ru) — общий бот-токен, дублирует Telegram-уведомления о заявках.
# Юзер должен один раз написать боту в MAX (или добавить в группу), иначе GET /chats пуст и слать некуда.
MAX_BOT_TOKEN=

# --- kie.ai (картинки Nano Banana 2) — общий ключ ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# --- FTP-хостинг сайта — СВОЙ у каждого сайта ---
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=

# --- Агент ---
MAX_NEW_PAGES=5
DRY_RUN=false
BATCH_COUNT=150
CONFIDENCE_MIN=0.78

# Google PageSpeed Insights (Core Web Vitals в daily-report, блок «Качество и техника»).
# Бесплатный ключ: https://developers.google.com/speed/docs/insights/v5/get-started. Без ключа работает с квотой.
PAGESPEED_KEY=
