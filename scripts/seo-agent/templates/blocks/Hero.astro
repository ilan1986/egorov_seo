---
// Hero — первый экран лендинга: заголовок-тезис, подзаголовок, 1-2 CTA, опц. картинка справа.
// Донор идей: AstroWind (onwidget/astrowind, MIT). Переписан под чистый CSS без Tailwind.
// props: title, subtitle, tagline?, primary?{text,href}, secondary?{text,href}, image?{src,alt}
interface Props {
  title: string;
  subtitle?: string;
  tagline?: string;
  primary?: { text: string; href: string };
  secondary?: { text: string; href: string };
  image?: { src: string; alt: string };
}
const { title, subtitle, tagline, primary, secondary, image } = Astro.props;
---
<section class="hero">
  <div class="hero__inner">
    <div class="hero__text">
      {tagline && <p class="hero__tagline">{tagline}</p>}
      <h1 class="hero__title" set:html={title} />
      {subtitle && <p class="hero__sub">{subtitle}</p>}
      {(primary || secondary) && (
        <div class="hero__cta">
          {primary && <a class="btn btn--primary" href={primary.href}>{primary.text}</a>}
          {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.text}</a>}
        </div>
      )}
    </div>
    {image && <div class="hero__media"><img src={image.src} alt={image.alt} loading="eager" /></div>}
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 20px; }
  .hero__inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .hero__tagline { text-transform: uppercase; letter-spacing: .08em; font-size: 13px; font-weight: 700; color: var(--accent, #3b5bdb); margin: 0 0 14px; }
  .hero__title { font-size: clamp(30px, 5vw, 52px); line-height: 1.08; margin: 0 0 18px; letter-spacing: -0.02em; text-wrap: balance; color: var(--navy, #16233a); }
  .hero__sub { font-size: clamp(16px, 2.2vw, 20px); line-height: 1.55; color: var(--muted, #5a6577); max-width: 40ch; margin: 0 0 28px; }
  .hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; justify-content: center; padding: 13px 24px; border-radius: 12px; font-weight: 600; font-size: 15px; text-decoration: none; transition: transform .12s ease, box-shadow .12s ease; }
  .btn--primary { background: var(--navy, #16233a); color: #fff; box-shadow: 0 6px 20px rgba(22,35,58,.18); }
  .btn--primary:hover { transform: translateY(-1px); box-shadow: 0 10px 28px rgba(22,35,58,.26); }
  .btn--ghost { background: transparent; color: var(--navy, #16233a); border: 1.5px solid var(--border, #d9deea); }
  .btn--ghost:hover { border-color: var(--navy, #16233a); }
  .hero__media img { width: 100%; height: auto; border-radius: 18px; }
  @media (max-width: 820px) { .hero__inner { grid-template-columns: 1fr; } .hero__media { order: -1; } }
</style>
