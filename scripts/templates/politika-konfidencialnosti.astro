---
// ШАБЛОН страницы политики конфиденциальности (152-ФЗ). Скопировать в
// src/pages/politika-konfidencialnosti/index.astro. Заменить путь импорта layout под свой сайт.
// Реквизиты берутся из PROFILE.legal (site.profile.mjs). Требование закона: политика — ТЕКСТОМ
// на HTML-странице, НЕ скачиваемый .doc/.pdf.
import BaseLayout from '../../layouts/BaseLayout.astro'; // TODO: путь к layout вашего сайта
import { PROFILE } from '../../../site.profile.mjs';
const L = PROFILE.legal || {};
const SITE = (PROFILE.site?.url || PROFILE.siteUrl || '').replace(/\/$/, '');
const updated = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Политика конфиденциальности"
  description="Политика обработки персональных данных в соответствии с Федеральным законом №152-ФЗ «О персональных данных»."
  path={L.policyPath || '/politika-konfidencialnosti/'}
  noindex={true}
>
  <section class="section">
    <div class="container" style="max-width:820px">
      <h1>Политика конфиденциальности</h1>
      <p class="muted">Действует с {updated}</p>
      <div class="prose">
        <p>Настоящая Политика определяет порядок обработки и защиты персональных данных пользователей
          сайта {SITE} (далее — Сайт) в соответствии с Федеральным законом от 27.07.2006 №152-ФЗ
          «О персональных данных».</p>

        <h2>1. Какие данные мы собираем</h2>
        <p>Данные, которые вы добровольно указываете в формах: имя, номер телефона, контакт в мессенджере,
          адрес электронной почты, текст обращения. Автоматически — обезличенные данные о посещении
          (cookie, данные систем веб-аналитики).</p>

        <h2>2. Цели обработки</h2>
        <ul>
          <li>обработка заявок и обращений, связь с вами;</li>
          <li>предоставление услуг и консультаций;</li>
          <li>улучшение работы Сайта и качества сервиса.</li>
        </ul>

        <h2>3. Правовые основания</h2>
        <p>Обработка осуществляется на основании вашего согласия, предоставляемого при отправке формы,
          а также для исполнения договора, стороной которого вы являетесь.</p>

        <h2>4. Передача третьим лицам</h2>
        <p>Мы не передаём персональные данные третьим лицам, кроме случаев, предусмотренных
          законодательством РФ. Для веб-аналитики используется Яндекс Метрика (обезличенные данные).</p>

        <h2>5. Хранение и защита</h2>
        <p>Данные хранятся не дольше, чем требуют цели обработки или законодательство. Приняты
          организационные и технические меры защиты от несанкционированного доступа.</p>

        <h2>6. Ваши права</h2>
        <p>Вы вправе запросить информацию об обработке ваших данных, потребовать их уточнения,
          блокирования или удаления, а также отозвать согласие, направив обращение по контактам ниже.</p>

        <h2>7. Оператор и контакты</h2>
        <p>Оператор персональных данных: {L.entityName}{L.ogrnip && <>, ОГРНИП {L.ogrnip}</>}{L.inn && <>, ИНН {L.inn}</>}{L.address && <>, адрес: {L.address}</>}.</p>
        {(L.phone || L.email) && (
          <p>По вопросам обработки персональных данных:
            {L.phone && <> телефон <a href={L.phoneHref || `tel:${L.phone}`}>{L.phone}</a></>}
            {L.email && <>, e-mail <a href={`mailto:${L.email}`}>{L.email}</a></>}.
          </p>
        )}
        {L.disclaimer && <p class="muted small">{L.disclaimer}</p>}
      </div>
    </div>
  </section>
</BaseLayout>
